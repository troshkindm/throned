/* Layered on top of the resolved base sheet: only the things the palette alone
   cannot say. Gradient stops are taken from the 2009 mockup verbatim. */

QFrame#titleBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C6558D, stop:1 #A93670);
    border-bottom: 1px solid #AE6086;
}
QFrame#commandBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #B9417C, stop:1 #A7356D);
    border-bottom: 1px solid #AE6086;
}
QFrame#statusCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #B9417C, stop:1 #A93670);
    border-top: 1px solid #AE6086;
}

/* Tabs and the star as physical, lit buttons rather than flat pills. */
QTabWidget#groupsCard QTabBar::tab, QToolButton#favoritesTabButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #B9417C, stop:1 #A7356D);
    border: 1px solid #AE6086;
}
QTabWidget#groupsCard QTabBar::tab:selected, QToolButton#favoritesTabButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #D63A82, stop:1 #B92770);
    border: 1px solid #D63A82;
}

QWidget[thronedCard="true"], QTabWidget#logsCard::pane, QWidget#statsPanelHost {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #A7356D, stop:1 #A93670);
}

QTableView::item:selected, QTableWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #D63A82, stop:1 #B92770);
}
