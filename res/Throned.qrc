<RCC>
    <qresource prefix="/">
        <file>icon/material/check.svg</file>
    </qresource>
    <qresource prefix="/Throned">
        <file alias="Throned.png">public/Throned.png</file>
        <file alias="Dns.png">public/Dns.png</file>
        <file alias="Off.png">public/Off.png</file>
        <file alias="Proxy.png">public/Proxy.png</file>
        <file alias="Proxy-Dns.png">public/Proxy-Dns.png</file>
        <file alias="Tun.png">public/Tun.png</file>
        <file>dashboard-notice.html</file>
        <file>dashboard-bootstrap.html</file>
    </qresource>
    <qresource prefix="/schema">
        <file alias="sing-box.json">schema/sing-box.json</file>
    </qresource>
    <qresource prefix="/skins">
        <file alias="mica-windows-11/skin.json">../skins/mica-windows-11/skin.json</file>
        <file alias="mica-windows-11/skin.qss">../skins/mica-windows-11/skin.qss</file>
        <file alias="retro-2009-pink/skin.json">../skins/retro-2009-pink/skin.json</file>
        <file alias="retro-2009-pink/skin.qss">../skins/retro-2009-pink/skin.qss</file>
        <file alias="retro-2009-teal/skin.json">../skins/retro-2009-teal/skin.json</file>
        <file alias="retro-2009-teal/skin.qss">../skins/retro-2009-teal/skin.qss</file>
        <file alias="retro-2009-teal/icons/star.svg">../skins/retro-2009-teal/icons/star.svg</file>
    </qresource>
</RCC>
